# DeskcommCRM 国内部署配套 · 环境变量样例
# 用法：复制为 .env 后交给上游 hostgator-setup-kit/install.sh --yes
# 完整字段见上游 .env.hostgator.example（本文件只保留「你必须填」的最小集）
# 上游：https://github.com/melgarafael/DeskcommCRM

# ── 镜像（建议钉死版本号；stable 会随发版移动）────────────────
# release 标签是 v1.97.0，镜像 tag 一般不带 v：1.97.0
APP_IMAGE=ghcr.io/melgarafael/deskcommcrm:1.97.0
APP_PULL_POLICY=missing
WORKER_IMAGE=ghcr.io/melgarafael/deskcomm-worker:1.97.0
WORKER_PULL_POLICY=missing
SCHEDULER_IMAGE=ghcr.io/melgarafael/deskcomm-scheduler:1.97.0
SCHEDULER_PULL_POLICY=always

# ── 域名 / HTTPS（A 记录指向 VPS；国内也可用 Cloudflare）─────
DOMAIN=crm.example.com
ACME_EMAIL=you@example.com

# 若 VPS 已有 Traefik/Coolify/Dokploy 占 80/443：
# REVERSE_PROXY=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# ── Supabase（云端免费档即可；务必用 Session pooler，勿用 Direct IPv6）──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler 连接串（常见端口 5432 或 6543，主机含 pooler）
SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres

# 可选：安装前 export SUPABASE_ACCESS_TOKEN=sbp_... 让 install.sh 自动建库填上述四项

# ── 对外 URL（一般与 DOMAIN 一致）────────────────────────────
NEXT_PUBLIC_APP_URL=https://crm.example.com
NEXT_PUBLIC_ADMIN_URL=https://crm.example.com

# ── AI（安装时可后填；OpenRouter / Anthropic / OpenAI 三选一即可）──
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── 管理员（首个账号；install.sh 也会交互询问）───────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ── 内部密钥（留空则由 install.sh 自动生成）──────────────────
# INTERNAL_SECRET=
# INTERNAL_CRON_SECRET=
# WAHA_API_KEY=
# WAHA_HMAC_SECRET=

# 语音通话 profile 默认关闭（上游默认安全；勿随意打开）
COMPOSE_PROFILES=
